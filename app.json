{
  "expo": {
    "name": "Cuentas",
    "slug": "cuentas-negocio",
    "version": "1.0.4",
    "icon": "./assets/iconography/app-icon.png",
    "splash": {
      "image": "./assets/iconography/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071B3D"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/iconography/app-icon.png"
    },
    "android": {
      "package": "com.euridev.cuentasnegocio",
      "versionCode": 5,
      "icon": "./assets/iconography/app-icon.png",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconography/adaptive-foreground.png",
        "monochromeImage": "./assets/iconography/adaptive-monochrome-v2.png",
        "backgroundColor": "#071B3D"
      }
    },
    "web": {
      "favicon": "./assets/iconography/favicon.png",
      "themeColor": "#162033",
      "backgroundColor": "#EEF2F7"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/iconography/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#071B3D"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "dacd0498-ac00-4d42-9090-2527b67f0e19"
      }
    },
    "owner": "euriluis"
  }
}
